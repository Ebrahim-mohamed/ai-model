APP_NAME="Raylab"
APP_VERSION="0.1"

# ========================= Postgres Config =========================
POSTGRES_USERNAME=""
POSTGRES_PASSWORD=""
POSTGRES_HOST="localhost"
POSTGRES_PORT=5433
POSTGRES_MAIN_DATABASE="raylab"

# ========================= MSAL / OneDrive =========================
MSAL_CLIENT_ID=
TOKEN_CACHE_ENCRYPTION_KEY=
ONEDRIVE_AUTH_BACKEND_LITERAL = ["MSAL_GRAPH"]
ONEDRIVE_AUTH_BACKEND="MSAL_GRAPH"

# ========================= Embedding Backend =========================
EMBEDDING_BACKEND_LITERAL = ["BGE_M3", "SWAN_LARGE"]
EMBEDDING_BACKEND="BGE_M3"
# Only needed for the SWAN_LARGE candidate (gated HF repo) — leave blank
# for BGE_M3, which is ungated. See README's Step 8 section.
HF_TOKEN=

# ========================= Vector DB Backend =========================
VECTOR_DB_BACKEND_LITERAL = ["PGVECTOR"]
VECTOR_DB_BACKEND="PGVECTOR"

# ========================= Reranker Backend =========================
# 2026-09-02: BGE_RERANKER_V2_M3 (BAAI/bge-reranker-v2-m3, ~0.6B params,
# same BGE-M3 lineage as EMBEDDING_BACKEND) is a togglable A/B candidate
# against the deployed CROSS_ENCODER default — flip RERANKER_BACKEND to
# test it, no code change needed. Real, larger model -> expect higher
# per-request reranking latency; keep CROSS_ENCODER as the default until
# real traffic justifies the swap.
RERANKER_BACKEND_LITERAL = ["CROSS_ENCODER", "BGE_RERANKER_V2_M3"]
RERANKER_BACKEND="CROSS_ENCODER"

# ========================= Celery Task Queue Config =========================
CELERY_BROKER_URL="amqp://username:password@localhost:5673/raylab_vhost"
CELERY_RESULT_BACKEND="redis://:password@localhost:6380/0"
CELERY_TASK_SERIALIZER="json"
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_ACKS_LATE=true
CELERY_WORKER_CONCURRENCY=2

# ========================= Section 3 Step 1: Generation Backend =========================
# Point this at a real, running OpenAI-compatible endpoint
# (e.g. `vllm serve Qwen/Qwen2.5-7B-Instruct --port 8001`).
#
# Phase 0 bake-off (see README's Phase 0 section): GENERATION_BACKEND
# selects which providers/*.py adapter runs; GENERATION_MODEL_NAME must
# match whatever --served-model-name (or the repo's own default name)
# vLLM was actually launched with, or every request 404s.
GENERATION_BACKEND_LITERAL = ["QWEN2_5_7B_INSTRUCT", "FALCON_H1_34B_INSTRUCT", "NILE_CHAT_12B", "QWEN2_5_32B_INSTRUCT_AWQ"]
GENERATION_BACKEND="QWEN2_5_7B_INSTRUCT"
GENERATION_BASE_URL="http://localhost:8001"
GENERATION_MODEL_NAME="qwen25"
# Raised from 30 -> 120 during Phase 0 (see README): real golden-suite
# traffic against a --enforce-eager, Colab-tunneled 34B candidate showed
# 5/67 turns exceeding a 30s budget purely on inference latency, not a
# hang. Revisit downward once a production backend is finalized and
# self-hosted with normal (non-eager) throughput.
GENERATION_REQUEST_TIMEOUT_SECONDS=120

# ========================= Section 3 Step 1: Query Router Sidecar (2026-08-30) =========================
# A SEPARATE model dedicated to IntentRoutingController's
# classify_intent()/rewrite_query() calls only — never used for Mode A
# reply generation. 2026-09-01: NILE_CHAT_4B retired entirely (real
# evidence — see QueryRouterInterface's own docstring) and replaced by
# NILE_CHAT_12B_BASE — the RAW, unadapted MBZUAI-Paris/Nile-Chat-12B
# checkpoint, deliberately NOT the fine-tuned GENERATION_BACKEND
# deployment (different served model, even though it's the same base
# weights). Point this at a real, running OpenAI-compatible endpoint
# serving the base checkpoint (e.g. `vllm serve MBZUAI-Paris/Nile-Chat-12B
# --served-model-name nile-chat-12b-base --port 8002`), on its own port,
# separate from GENERATION_BASE_URL's deployment.
QUERY_ROUTER_BACKEND_LITERAL = ["NILE_CHAT_12B_BASE"]
QUERY_ROUTER_BACKEND="NILE_CHAT_12B_BASE"
QUERY_ROUTER_BASE_URL="http://localhost:8002"
QUERY_ROUTER_MODEL_NAME="nile-chat-12b-base"
# Deliberately tighter than GENERATION_REQUEST_TIMEOUT_SECONDS — see
# helpers/config.py's own comment on this field for why. Starting point
# only; revisit once real latency against the deployed sidecar is
# measured.
QUERY_ROUTER_REQUEST_TIMEOUT_SECONDS=20

# ========================= Section 3 Step 1: Session Store (Tier 1, Redis) =========================
SESSION_REDIS_URL="redis://:password@localhost:6380/1"
SESSION_TTL_SECONDS=86400
SESSION_HISTORY_WINDOW=6

# ========================= Section 3 Step 1: RAG pipeline tracing =========================
RAG_LOG_FILE_PATH="rag_execution.log"
RAG_LOG_LEVEL="INFO"

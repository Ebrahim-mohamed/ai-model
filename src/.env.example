APP_NAME="Raylab"
APP_VERSION="0.1"

# ========================= Postgres Config =========================
POSTGRES_USERNAME=""
POSTGRES_PASSWORD=""
POSTGRES_HOST="localhost"
POSTGRES_PORT=5433
POSTGRES_MAIN_DATABASE="raylab"

# ========================= MSAL / OneDrive =========================
MSAL_CLIENT_ID=
TOKEN_CACHE_ENCRYPTION_KEY=
ONEDRIVE_AUTH_BACKEND_LITERAL = ["MSAL_GRAPH"]
ONEDRIVE_AUTH_BACKEND="MSAL_GRAPH"

# ========================= Embedding Backend =========================
EMBEDDING_BACKEND_LITERAL = ["BGE_M3", "SWAN_LARGE"]

# ========================= Chunking Defaults =========================
DEFAULT_BOILERPLATE_THRESHOLD=0.9
